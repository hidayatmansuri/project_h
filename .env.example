# Django Secret Key (Do not share this in production!)
SECRET_KEY=your-secret-key-goes-here

# Database Configuration (PostgreSQL)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- projectauth ---
PROJECTAUTH_ENCRYPTION_KEYS=kid1:<generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())">
PROJECTAUTH_SITE_NAME=project-h
PROJECTAUTH_BASE_URL=http://127.0.0.1:8000
PROJECTAUTH_ADMIN_NOTIFY_EMAILS=
PROJECTAUTH_MAX_EMAILS_PER_DAY=300       # safety cap below Gmail's free daily limit
PROJECTAUTH_HIBP_CHECK=False
PROJECTAUTH_INIT_ADMIN_PASSWORD=
# --- email: dev = console, production = Gmail SMTP with an App Password ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# production values:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=<dedicated gmail address>
#   EMAIL_HOST_PASSWORD=<16-character Google App Password>
#   DEFAULT_FROM_EMAIL=<the same gmail address>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# --- local development ---
DJANGO_DEBUG=True                        # settings.py default becomes False (Phase 7); keep True locally
# --- production hardening (all read in settings.py) ---
SECURE_PROXY_SSL=False
SECURE_HSTS_SECONDS=3600
CSRF_TRUSTED_ORIGINS=
AXES_IPWARE_PROXY_COUNT=0
